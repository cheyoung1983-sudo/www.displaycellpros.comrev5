AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_SECRET=
# Required by @auth0/nextjs-auth0 to build absolute redirect/callback URLs
# (e.g. http://localhost:3000 in dev, https://www.displaycellpros.com in prod).
APP_BASE_URL=
# Optional: API identifier for the rev4 Custom API, passed as the
# authorization `audience` so access tokens can call it. Unset = no audience.
AUTH0_AUDIENCE=
AUTH0_RBAC_EXTENSION_API_KEY=
AWS_ACCOUNT_ID=
AWS_REGION=
AWS_RESOURCE_ARN=
AWS_ROLE_ARN=
# Required for the Vercel AI Gateway (Triage AI / Data Expert agents, generateText calls).
AI_GATEWAY_API_KEY=
# HMAC-SHA256 signing key for NIST SP 800-88 erasure certificates. Keep this secret —
# anyone with it can forge a Certificate of Erasure.
ERASURE_HMAC_SECRET=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPO_NAME=
GITHUB_REPO_OWNER=
GITHUB_TOKEN=
OPENAI_API_KEY=
PGDATABASE=
PGHOST=
PGHOST_READ_ONLY=
PGPASSWORD=
PGPORT=
PGSSLMODE=
PGUSER=
SHOPIFY_ADMIN_API_TOKEN=
# Required for Storefront API calls (product lookup + intake checkout carts).
# Without both, /api/intake/sync cannot create a real checkout.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Triage AI (ElevenLabs conversational agent) tool endpoints under /api/pricing/quote,
# /api/intake/dispatch-sms, /api/intake/escalate-tier3. Each degrades gracefully
# (logs only, no real send) when its section below is unset.
# Shared secret the agent's webhook tools send back as X-Triage-Tool-Secret;
# unset accepts tool calls unverified (dev/sandbox mode).
TRIAGE_TOOL_WEBHOOK_SECRET=
# Required together for dispatch_booking_link to send a real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Slack Incoming Webhook URL for escalate_tier3_ticket alerts.
SLACK_ESCALATION_WEBHOOK_URL=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=