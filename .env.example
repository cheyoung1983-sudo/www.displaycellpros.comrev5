# Required for Storefront API calls (product lookup + intake checkout carts).
# Without both, /api/intake/sync cannot create a real checkout.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Triage AI (ElevenLabs conversational agent) tool endpoints under /api/pricing/quote,
# /api/intake/dispatch-sms, /api/intake/escalate-tier3. Each degrades gracefully
# (logs only, no real send) when its section below is unset.
# Shared secret the agent's webhook tools send back as X-Triage-Tool-Secret;
# unset accepts tool calls unverified (dev/sandbox mode).
TRIAGE_TOOL_WEBHOOK_SECRET=
# Required together for dispatch_booking_link to send a real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Slack Incoming Webhook URL for escalate_tier3_ticket alerts.
SLACK_ESCALATION_WEBHOOK_URL=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
